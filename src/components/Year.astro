---
// Hitung Tahun Ajaran Pendaftaran (SPMB/PPDB)
// Ajaran baru dimulai bulan Juli (bulan ke-7, index 6).
// Jika bulan >= Juli (6-11): pendaftaran dibuka untuk tahun ajaran baru: (tahun ini + 1) / (tahun ini + 2).
// Contoh: September 2026 -> 2027/2028.
// Jika bulan < Juli (0-5): pendaftaran untuk tahun ajaran yang akan mulai Juli: (tahun ini) / (tahun ini + 1).
// Contoh: Februari 2027 -> 2027/2028.
const now = new Date();
const currentYear = now.getFullYear();
const startYear = now.getMonth() >= 6 ? currentYear + 1 : currentYear;
const endYear = startYear + 1;
const academicYear = `${startYear}/${endYear}`;
---

<span class="academic-year">{academicYear}</span>

<script>
  function updateAcademicYears() {
    const now = new Date();
    const currentYear = now.getFullYear();
    const startYear = now.getMonth() >= 6 ? currentYear + 1 : currentYear;
    const endYear = startYear + 1;
    const academicYear = `${startYear}/${endYear}`;

    document.querySelectorAll('.academic-year').forEach((el) => {
      el.textContent = academicYear;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateAcademicYears);
  } else {
    updateAcademicYears();
  }
</script>