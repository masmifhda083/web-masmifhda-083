---
// src/components/HeroSection.astro
import { getCollection } from 'astro:content';

const settingsData = await getCollection('settings');
const settings = settingsData[0]?.data;

const slider = settings?.slider || {};
const schoolInfo = slider.schoolInfo || {};
const images = slider.images?.length ? slider.images : [
  { url: '/uploads/cover.webp', alt: 'Dokumentasi MA Miftahul Huda 1' },
  { url: '/uploads/mifda-1.webp', alt: 'Dokumentasi MA Miftahul Huda 2' },
  { url: '/uploads/mifda-15.webp', alt: 'Dokumentasi MA Miftahul Huda 3' },
];

const schoolName = schoolInfo.name || "MA MIFTAHUL HUDA";
const city = schoolInfo.city || "TAMBAK JAYA";
const motto = schoolInfo.motto || "Madrasah Aliyah yang membentuk generasi berilmu, berkarakter islami, dan berwawasan luas.";
const accreditation = schoolInfo.accreditation || "Akreditasi B+";
---

<section class="relative min-h-[600px] lg:min-h-[680px] w-full flex items-end justify-start overflow-hidden pt-24 bg-slate-900">
  
  <!-- 100% Full-Width Edge-to-Edge Crossfade Background Slider -->
  <div 
    class="absolute inset-0 z-0 w-full h-full overflow-hidden"
    x-data={`{
      current: 0,
      total: ${images.length},
      timer: null,
      init() {
        this.timer = setInterval(() => {
          this.current = (this.current + 1) % this.total;
        }, 5000);
      }
    }`}
  >
    {images.map((image: any, index: number) => (
      <div
        class="absolute inset-0 w-full h-full transition-all duration-1000 ease-in-out"
        :class={`current === ${index} ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-105 z-0 pointer-events-none'`}
        style="transition: opacity 1.2s ease-in-out, transform 7s ease-out;"
      >
        <img 
          src={image.url} 
          alt={image.alt || `Dokumentasi MA Miftahul Huda ${index + 1}`}
          class="w-full h-full object-cover object-center"
          loading={index === 0 ? 'eager' : 'lazy'}
        />
      </div>
    ))}
  </div>

  <!-- Left-to-right subtle dark gradient overlay for crystal-clear contrast -->
  <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-black/90 via-black/55 to-black/20 pointer-events-none z-10"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-transparent to-black/30 pointer-events-none z-10"></div>

  <!-- Editorial Left-Aligned Content Overlay -->
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl relative z-20 pb-12 lg:pb-16 w-full">
    <div class="max-w-2xl text-left">
      
      <!-- Big Modern Headline (Plus Jakarta Sans & Bold) -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-[1.08] mb-4 drop-shadow-md">
        {schoolName}<br />
        <span class="text-amber-400">{city}</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-white/90 leading-relaxed max-w-xl mb-8 font-medium">
        {motto}
      </p>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3 mb-10">
        <a 
          href="/about" 
          class="px-6 py-3 bg-primary hover:bg-secondary !text-white font-bold text-sm sm:text-base rounded-full transition-all shadow-lg hover:shadow-primary/30 flex items-center gap-2"
        >
          <span>Profile Sekolah</span>
        </a>

        <a 
          href="/pendaftaran" 
          class="px-6 py-3 bg-amber-400 !text-white font-bold text-sm sm:text-base rounded-full"
        >
          <span>Pendaftaran</span>
        </a>
      </div>

      <!-- Feature Info Bar at the Bottom -->
      <div class="flex flex-wrap items-center gap-2 text-xs text-white/80 pt-4 border-t border-white/15">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/15 font-semibold">
          🏛️ {accreditation}
        </span>
      </div>

    </div>
  </div>
</section>
