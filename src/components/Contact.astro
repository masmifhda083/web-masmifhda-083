---
// components/Contact.astro
import contactJson from "../content/contact/index.json";
import { SOCIAL_ICON_REGISTRY } from "../config/socialIcons";

const contact = contactJson;

type SocialIconRegistry = Record<string, { label: string; svg: string }>;

const getSocialIcon = (key: string): string => {
  return (SOCIAL_ICON_REGISTRY as SocialIconRegistry)[key]?.svg ?? "";
};

const getSocialLabel = (key: string): string => {
  return (SOCIAL_ICON_REGISTRY as SocialIconRegistry)[key]?.label ?? key;
};
---

<!-- Page Header -->
<section class="bg-surface border-b border-border py-12 md:py-16">
  <div class="container mx-auto px-4 max-w-6xl">
    <!-- Breadcrumb -->
    <nav
      class="flex items-center gap-2 text-xs md:text-sm text-muted mb-4"
      aria-label="Breadcrumb"
    >
      <a
        href="/"
        class="hover:text-primary transition-colors flex items-center gap-1"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
          ></path>
        </svg>
        Home
      </a>
      <span>/</span>
      <span class="text-heading font-medium">Kontak</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold font-sans text-heading mb-3">
      Kontak & Lokasi Madrasah
    </h1>
    <p class="text-base text-muted max-w-2xl leading-relaxed">
      Layanan informasi pendaftaran santri baru, administrasi tata usaha, serta
      panduan lokasi kampus MA Miftahul Huda Tambak Jaya.
    </p>
  </div>
</section>

<!-- Main Content: Side-by-Side 2 Column Layout -->
<section class="py-12 md:py-16 bg-background">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Informasi Kontak & Jam Kerja (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Box 1: Alamat & Kontak Langsung -->
        <div class="bg-surface rounded-xl p-6 border border-border">
          <h2
            class="text-lg font-bold text-heading mb-4 pb-3 border-b border-border"
          >
            Kantor Tata Usaha
          </h2>

          <!-- Alamat -->
          <div class="flex items-start gap-3 mb-6">
            <div
              class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <p
                class="text-xs font-semibold text-muted uppercase tracking-wider"
              >
                Alamat
              </p>
              <p class="text-sm text-text font-medium mt-0.5 leading-snug">
                Jl. Tirtomoyo, Tambak Jaya, Kec. Way Tenong, Kab. Lampung Barat,
                Lampung 34884
              </p>
              <span class="inline-block text-xs text-primary font-semibold mt-1"
                >NPSN: 10648392</span
              >
            </div>
          </div>

          <!-- Saluran Kontak -->
          <div class="space-y-3 pt-4 border-t border-border">
            <!-- WhatsApp -->
            <a
              href="https://wa.me/6281938240819?text=Assalamualaikum%20Admin%20MA%20Miftahul%20Huda"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-3 rounded-lg bg-background border border-border hover:border-emerald-500 transition-colors group"
            >
              <div class="flex items-center gap-3">
                <div
                  class="w-8 h-8 rounded-md bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-muted">WhatsApp</p>
                  <p
                    class="text-sm font-semibold text-heading group-hover:text-emerald-700 transition-colors"
                  >
                    +62 819-3824-0819
                  </p>
                </div>
              </div>
              <span class="text-xs font-semibold text-emerald-700"
                >Chat &rarr;</span
              >
            </a>

            <!-- Telepon -->
            <a
              href="tel:+6281938240819"
              class="flex items-center justify-between p-3 rounded-lg bg-background border border-border hover:border-primary transition-colors group"
            >
              <div class="flex items-center gap-3">
                <div
                  class="w-8 h-8 rounded-md bg-primary/10 text-primary flex items-center justify-center shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-muted">Telepon</p>
                  <p
                    class="text-sm font-semibold text-heading group-hover:text-primary transition-colors"
                  >
                    +62 819-3824-0819
                  </p>
                </div>
              </div>
              <span class="text-xs font-semibold text-primary"
                >Panggil &rarr;</span
              >
            </a>

            <!-- Email -->
            <a
              href="mailto:masmifhda083@gmail.com"
              class="flex items-center justify-between p-3 rounded-lg bg-background border border-border hover:border-blue-500 transition-colors group"
            >
              <div class="flex items-center gap-3 min-w-0">
                <div
                  class="w-8 h-8 rounded-md bg-blue-100 text-blue-700 flex items-center justify-center shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    ></path>
                  </svg>
                </div>
                <div class="min-w-0">
                  <p class="text-xs text-muted">Email</p>
                  <p
                    class="text-sm font-semibold text-heading group-hover:text-blue-700 transition-colors truncate"
                  >
                    masmifhda083@gmail.com
                  </p>
                </div>
              </div>
              <span class="text-xs font-semibold text-blue-700 shrink-0 ml-2"
                >Kirim &rarr;</span
              >
            </a>
          </div>
        </div>

        <!-- Box 2: Jam Pelayanan & Media Sosial -->
        <div class="bg-surface rounded-xl p-6 border border-border">
          <h2
            class="text-lg font-bold text-heading mb-4 pb-3 border-b border-border"
          >
            Jam Pelayanan
          </h2>

          <div class="space-y-2 text-sm mb-6">
            {
              contact.hours.days.map((item) => (
                <div class="flex items-center justify-between py-1.5 border-b border-border/50 last:border-b-0">
                  <span class="text-text font-medium">{item.day}</span>
                  <span class="font-bold text-primary">{item.time}</span>
                </div>
              ))
            }
            <div class="flex items-center justify-between py-1.5 text-muted">
              <span>Minggu & Hari Libur</span>
              <span class="font-medium text-xs">Tutup</span>
            </div>
          </div>

          <h3
            class="text-xs font-bold text-muted uppercase tracking-wider mb-3 pt-4 border-t border-border"
          >
            Media Sosial
          </h3>
          <div class="grid grid-cols-2 gap-2">
            {
              (contact.socialMedia?.links ?? []).map((social) => (
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 p-2.5 rounded-lg bg-background border border-border hover:border-primary hover:text-primary transition-colors text-xs font-semibold text-heading"
                >
                  <span
                    set:html={getSocialIcon(social.iconKey)}
                    class="text-primary *:w-4 *:h-4"
                  />
                  <span>{getSocialLabel(social.iconKey)}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Right Column: Peta Google Maps (7 Cols) -->
      <div class="lg:col-span-7 bg-surface rounded-xl p-6 border border-border">
        <div
          class="flex items-center justify-between mb-4 pb-3 border-b border-border"
        >
          <div>
            <h2 class="text-lg font-bold text-heading">Lokasi Kampus</h2>
            <p class="text-xs text-muted">
              Google Maps MA Miftahul Huda Mathla'ul Anwar
            </p>
          </div>
          <a
            href="https://maps.google.com/?q=MAS+MIFTAHUL+HUDA+MATHLA'UL+ANWAR+Lampung+Barat"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-primary hover:bg-secondary !text-white text-xs font-semibold rounded-lg transition-colors shadow-sm"
          >
            <span>Petunjuk Arah</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-3.5 h-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path>
            </svg>
          </a>
        </div>

        <div
          class="rounded-lg overflow-hidden border border-border bg-background"
        >
          <iframe
            src={contact.mapEmbedUrl}
            width="100%"
            height="460"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Lokasi MAS Miftahul Huda"
            class="w-full block"></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
