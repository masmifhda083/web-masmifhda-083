---
// file: src/components/Highlight.astro
import { getCollection, getEntry } from "astro:content";
import Year from "./Year.astro";

// Fetch pengumuman posts
const allPosts = await getCollection("posts").catch(() => []);
const processedPosts = allPosts.map((post) => {
  const category = (post.data.category || "").toLowerCase();
  const slug = post.id.split("/").pop()?.replace(/\.mdx?$/, "") || post.id;
  return {
    slug,
    category,
    data: post.data,
  };
});

const pengumumanPosts = processedPosts
  .filter((post) => post.category === "pengumuman" || post.category === "akademik")
  .sort((a, b) => {
    const dateA = new Date(a.data.pubdate ?? 0).getTime();
    const dateB = new Date(b.data.pubdate ?? 0).getTime();
    return dateB - dateA;
  })
  .slice(0, 3);

// Fetch Sambutan Kepala Sekolah
const about = await getEntry("about", "index").catch(() => null);
const sambutan = about?.data?.sambutan?.items?.[0];
const kepsekImage = sambutan?.image || "/uploads/kepsek.webp";

let kepsekName = "Ahmad Rifa'i, M.Pd.";
let sambutanExcerpt = "Selamat datang di website resmi MA Miftahul Huda Tambak. Kami berkomitmen membentuk generasi yang berilmu, berakhlak, dan siap menghadapi masa depan dengan iman dan ilmu.";

if (sambutan?.body) {
  const nameMatch = sambutan.body.match(/####\s*\*?\s*([^*#\n]+)\*?\s*$/m);
  if (nameMatch && nameMatch[1]) {
    kepsekName = nameMatch[1].trim();
  }

  const paragraphs = sambutan.body
    .split(/\n\s*\n/)
    .map((p: string) => p.replace(/[#*_-]/g, '').trim())
    .filter((p: string) => p.length > 30 && !p.toLowerCase().includes('bismillah') && !p.toLowerCase().includes('assalamu') && !p.toLowerCase().includes('wassalamu'));
  if (paragraphs[0]) {
    sambutanExcerpt = paragraphs[0].slice(0, 190) + (paragraphs[0].length > 190 ? '...' : '');
  }
}
const kepsekRole = "Kepala Madrasah";

function formatDateParts(dateVal: any) {
  const d = dateVal ? new Date(dateVal) : new Date();
  const day = d.getDate().toString().padStart(2, '0');
  const months = ['JAN', 'FEB', 'MAR', 'APR', 'MEI', 'JUN', 'JUL', 'AGU', 'SEP', 'OKT', 'NOV', 'DES'];
  const month = months[d.getMonth()];
  const year = d.getFullYear();
  return { day, month, year };
}
---

<section class="py-14 bg-background">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Kolom 1: Sambutan Kepala Madrasah (4.5 Cols) -->
      <div class="lg:col-span-5 bg-surface rounded-2xl p-7 border border-border shadow-sm flex flex-col justify-between">
        <div>
          <h2 class="text-xl font-bold text-heading mb-6 pb-3 border-b border-border flex items-center justify-between">
            <span>Sambutan Kepala Madrasah</span>
          </h2>

          <div class="flex flex-col sm:flex-row gap-5 items-start">
            <div class="w-28 h-36 rounded-xl overflow-hidden shrink-0 border border-border shadow-inner bg-primary/5">
              <img
                src={kepsekImage}
                alt={kepsekName}
                class="w-full h-full object-cover"
                onerror="this.onerror=null;this.src='/uploads/kepsek.webp';"
              />
            </div>
            <div class="text-xs md:text-sm text-muted leading-relaxed space-y-2">
              <p class="font-bold text-heading italic text-xs">
                Assalamu'alaikum Warahmatullahi Wabarakatuh
              </p>
              <p>
                {sambutanExcerpt}
              </p>
              <div class="pt-2">
                <p class="font-bold text-heading text-sm">{kepsekName}</p>
                <p class="text-xs text-primary font-medium">{kepsekRole}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-5 border-t border-border mt-6">
          <a
            href="/about/sambutan"
            class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:text-secondary transition-colors"
          >
            <span>Selengkapnya</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Kolom 2: Pengumuman Terbaru (4 Cols) -->
      <div class="lg:col-span-4 bg-surface rounded-2xl p-7 border border-border shadow-sm flex flex-col justify-between">
        <div>
          <div class="pb-3 mb-4 border-b border-border">
            <h2 class="text-xl font-bold text-heading">
              Pengumuman Terbaru
            </h2>
          </div>

          <div class="space-y-4">
            {pengumumanPosts.map((post) => {
              const { day, month, year } = formatDateParts(post.data.pubdate);
              const tag = post.category === "pengumuman" ? "PENERIMAAN" : "INFORMASI";

              return (
                <div class="flex items-start gap-3.5 group">
                  <!-- Date Block -->
                  <div class="w-12 h-14 rounded-lg bg-primary/10 border border-primary/20 flex flex-col items-center justify-center shrink-0 text-center leading-none">
                    <span class="text-sm font-bold text-heading">{day}</span>
                    <span class="text-[10px] font-bold text-primary tracking-wider uppercase mt-0.5">{month}</span>
                    <span class="text-[9px] text-muted">{year}</span>
                  </div>

                  <!-- Text -->
                  <div class="flex-1 min-w-0">
                    <span class="text-[10px] font-bold tracking-wider text-secondary uppercase block mb-0.5">
                      {tag}
                    </span>
                    <a
                      href={`/posts/${post.category}/${post.slug}`}
                      class="text-xs font-bold text-heading group-hover:text-primary transition-colors line-clamp-2 leading-snug block"
                    >
                      {post.data.title}
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <div class="pt-4 border-t border-border mt-4 text-center">
          <a
            href="/pengumuman"
            class="text-xs font-bold text-primary hover:text-secondary inline-flex items-center gap-1"
          >
            <span>Pusat Pengumuman Lengkap</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Kolom 3: Banner SPMB Hijau (3 Cols) -->
      <div class="lg:col-span-3 bg-gradient-to-br from-primary via-[#245427] to-[#163819] rounded-2xl p-7 text-white shadow-md flex flex-col justify-between relative overflow-hidden">
        <!-- Subtle image overlay -->
        <div class="absolute inset-0 bg-cover bg-center opacity-15 pointer-events-none" style="background-image: url(/uploads/mifda-1.webp);"></div>

        <div class="relative z-10">
          <span class="text-[11px] font-bold tracking-widest text-amber-400 uppercase block mb-2">
            SPMB Online <Year />
          </span>
          <h3 class="text-xl md:text-2xl font-bold mb-3 leading-tight text-white">
            PENERIMAAN MURID BARU (SPMB)
          </h3>
          <p class="text-xs text-white/85 leading-relaxed mb-6">
            Bersama keluarga besar MA Miftahul Huda Tambak, wujudkan masa depan yang gemilang.
          </p>
        </div>

        <div class="space-y-3 relative z-10 pt-4 border-t border-white/15">
          <a
            href="/pendaftaran"
            class="block w-full py-2.5 px-4 bg-white hover:bg-emerald-50 !text-primary font-bold text-xs rounded-xl text-center transition-all shadow-md"
          >
            Daftar Sekarang 
          </a>
          <a
            href="/pendaftaran"
            class="block text-center text-xs text-white/80 hover:text-white transition-colors"
          >
            Informasi Pendaftaran 
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
