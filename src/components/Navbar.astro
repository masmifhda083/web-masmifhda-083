---
// src/components/Navbar.astro
import { getCollection } from "astro:content";
import Year from "./Year.astro";

const settingsCollection = await getCollection("settings");
const settingsData = settingsCollection[0]?.data;

const headerData = settingsData?.header || {};
// Data untuk logo & nama
const schoolInfo = headerData?.schoolInfo || {
  name: "MA MIFTAHUL HUDA",
  logo: "/uploads/logo.webp",
  logoAlt: "Logo Sekolah",
  logoWidthDesktop: 44,
  logoWidthMobile: 36,
  showName: true,
};

// Data untuk menu items
const menuItems = [...(headerData?.items || [])];

// Fallback jika menu items kosong
if (menuItems.length === 0) {
  menuItems.push(
    { label: "Home", href: "/", isActive: true },
    { label: "Profil", href: "/about", isActive: true },
    { label: "Berita", href: "/posts/news", isActive: true },
    { label: "Pengumuman", href: "/pengumuman", isActive: true },
    { label: "Prestasi", href: "/posts/prestasi", isActive: true },
    { label: "OSIS", href: "/osis", isActive: true },
    { label: "Kontak", href: "/contact", isActive: true },
  );
}

// Ambil data pendaftaran untuk label CTA
const pendaftaranCollection = await getCollection("pendaftaran");
const pendaftaranData = pendaftaranCollection[0]?.data?.datappdb;
const pendaftaranLabel = pendaftaranData?.ppdbAlias || "SPMB";

// Get current path for active state
const currentPath = Astro.url.pathname;

// Function to check if menu item is active
const isActiveLink = (href: string): boolean => {
  if (href === "/") {
    return currentPath === "/" || currentPath === "";
  }
  return currentPath === href || currentPath.startsWith(href + "/");
};
---

<nav
  role="navigation"
  x-data="{ scrolled: false }"
  x-init="window.addEventListener('scroll', () => { scrolled = window.scrollY > 10 })"
  class="fixed top-0 left-0 right-0 z-50 bg-surface/95 backdrop-blur-md border-b border-border transition-all duration-300"
  :class="scrolled ? 'shadow-md py-0' : 'shadow-xs py-0'"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
    <div class="flex items-center justify-between h-16 lg:h-[72px]">
      <!-- Logo & Brand (Kiri) -->
      <a
        href="/"
        class="group flex gap-3 items-center relative z-10 transition-opacity hover:opacity-90"
      >
        <img
          src={schoolInfo.logo}
          alt={schoolInfo.logoAlt}
          class="w-10 h-10 lg:w-11 lg:h-11 object-contain shrink-0 transition-transform duration-300 group-hover:scale-105"
        />

        {
          schoolInfo.showName && (
            <div class="flex flex-col leading-tight">
              <span class="text-sm lg:text-base font-bold text-heading uppercase tracking-wide font-sans">
                {schoolInfo.name}
              </span>
              <span class="text-[11px] text-muted font-medium">
                Lampung Barat
              </span>
            </div>
          )
        }
      </a>

      <!-- Menu Navigation (Tengah) -->
      <ul class="hidden lg:flex items-center gap-1">
        {
          menuItems.map((item) => {
            const isActive = isActiveLink(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class={`relative px-3.5 py-2 font-semibold text-[13px] tracking-wide transition-colors duration-200 block ${
                    isActive
                      ? "!text-primary font-bold"
                      : "!text-heading/75 hover:!text-primary"
                  }`}
                >
                  <span>{item.label}</span>
                  {isActive && (
                    <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-5 h-0.5 bg-primary rounded-full" />
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>

      <!-- Right Side Actions (Kanan) -->
      <div class="flex items-center gap-3">
        <!-- CTA Button SPMB Desktop -->
        <a
          href="/pendaftaran"
          class="hidden lg:inline-flex items-center gap-2 px-5 py-2.5 rounded-full font-bold text-xs md:text-sm bg-primary hover:bg-secondary !text-white transition-all duration-200 shadow-sm hover:shadow-md hover:scale-[1.02] active:scale-[0.98]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-4 h-4 text-white shrink-0"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"
            ></path>
          </svg>
          <span>{pendaftaranLabel} <Year /></span>
        </a>

        <!-- Hamburger Button Mobile -->
        <button
          class="lg:hidden w-10 h-10 flex items-center justify-center rounded-xl bg-primary/5 hover:bg-primary/10 border border-border transition-colors z-10"
          x-on:click="$dispatch('toggle-mobile-menu')"
          aria-label="Toggle navigation"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-5 h-5 text-heading"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile Menu Drawer -->
<div
  x-data="{ open: false }"
  @toggle-mobile-menu.window="open = !open"
  x-effect="document.body.style.overflow = open ? 'hidden' : ''"
>
  <!-- Overlay Backdrop -->
  <div
    class="fixed inset-0 bg-black/60 backdrop-blur-xs lg:hidden z-[9998]"
    x-show="open"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    x-on:click="open = false"
    x-cloak
  >
  </div>

  <!-- Slide-Over Panel -->
  <div
    class="fixed inset-y-0 right-0 w-[290px] max-w-[85vw] bg-surface border-l border-border shadow-2xl lg:hidden z-[9999] flex flex-col justify-between"
    x-show="open"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-full"
    x-cloak
  >
    <div class="flex flex-col flex-1 overflow-y-auto">
      <!-- Mobile Drawer Header -->
      <div class="flex items-center justify-between p-4 border-b border-border">
        <div class="flex items-center gap-2.5">
          <img
            src={schoolInfo.logo}
            alt={schoolInfo.logoAlt}
            class="w-8 h-8 object-contain"
          />
          <span class="text-sm font-bold text-heading uppercase tracking-tight">
            {schoolInfo.name}
          </span>
        </div>
        <button
          class="w-8 h-8 flex items-center justify-center rounded-lg bg-muted/10 hover:bg-muted/20 text-heading transition-colors"
          x-on:click="open = false"
          aria-label="Close menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-4 h-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18 18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Navigation Links -->
      <nav class="p-3">
        <ul class="space-y-1">
          {
            menuItems.map((item) => {
              const isActive = isActiveLink(item.href);
              return (
                <li>
                  <a
                    href={item.href}
                    class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl font-semibold text-sm transition-colors ${
                      isActive
                        ? "!text-primary bg-primary/10"
                        : "!text-heading/80 hover:!text-primary hover:bg-primary/5"
                    }`}
                    x-on:click="open = false"
                  >
                    <span>{item.label}</span>
                    <span
                      class={`text-xs ${isActive ? "text-primary" : "text-muted"}`}
                    >
                      &rarr;
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>

    <!-- Mobile Drawer Footer CTA -->
    <div class="p-4 border-t border-border bg-surface">
      <a
        href="/pendaftaran"
        class="flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl font-bold text-xs bg-primary hover:bg-secondary !text-white shadow-md transition-all text-center"
        x-on:click="open = false"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-4 h-4 text-white"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"
          ></path>
        </svg>
        <span>Daftar {pendaftaranLabel} Online</span>
      </a>
      <p class="text-[10px] text-muted text-center mt-2.5">
        © {new Date().getFullYear()}
        {schoolInfo.name}
      </p>
    </div>
  </div>
</div>

<!-- Spacer agar konten tidak tertutup fixed navbar -->
<div class="h-16 lg:h-[72px]"></div>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>

<script>
  // Close mobile menu on escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const nav = document.querySelector("[x-data]") as HTMLElement & {
        __x?: { $data?: { open: boolean } };
      };
      if (nav && nav.__x && nav.__x.$data) {
        nav.__x.$data.open = false;
      }
    }
  });
</script>
