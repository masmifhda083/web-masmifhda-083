---
// file: components/LatestPosts.astro
import FormattedDate from "./FormattedDate.astro";
import { getCollection } from "astro:content";
import { getVisiblePosts } from "../utils/postFilter";

interface PostData {
  title: string;
  author?: string;
  pubdate?: Date | string;
  heroImage?: string;
  description?: string;
  category?: string;
}

interface AuthorData {
  username: string;
  name: string;
  avatar?: string;
  bio?: string;
}

interface Post {
  slug: string;
  category: string;
  data: PostData;
}

interface Props {
  posts: Post[];
  maxPosts?: number;
  layout?: 'grid' | 'sidebar' | 'editorial';
  showDescription?: boolean;
  showAuthorBio?: boolean;
}

const { 
  posts, 
  maxPosts = 6, 
  layout = 'grid', 
  showDescription = true,
  showAuthorBio = false
} = Astro.props;

const visiblePosts = getVisiblePosts(posts);
const displayedPosts = visiblePosts.slice(0, maxPosts);

async function getAuthorData(username: string): Promise<AuthorData | null> {
  if (!username) return null;
  try {
    const authors = await getCollection("authors");
    const author = authors.find(a => a.data.username === username);
    return author?.data ?? null;
  } catch (error) {
    return null;
  }
}

const authorPromises = displayedPosts
  .filter(post => post.data.author)
  .map(async (post) => {
    const authorData = await getAuthorData(post.data.author!);
    return { username: post.data.author!, data: authorData };
  });

const authorResults = await Promise.all(authorPromises);
const authorMap = new Map(
  authorResults.map(result => [result.username, result.data])
);

function excerpt(text: string | undefined, limit: number): string {
  if (!text) return "";
  return text.length > limit ? text.slice(0, limit) + "..." : text;
}
---

{layout === 'editorial' ? (
  <!-- Layout Editorial (1 Featured Utama + 3 Lainnya) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
    <!-- Featured 1st Post (7 cols) -->
    {displayedPosts[0] && (() => {
      const first = displayedPosts[0];
      const img = first.data?.heroImage || "/uploads/default-thumb.jpg";
      const pub = first.data?.pubdate ?? null;
      const dateObj = pub ? new Date(pub) : null;
      const rawCategory = first.data?.category || "news";
      const categorySlug = rawCategory.toLowerCase();
      const slug = first.slug || first.id?.split("/").pop()?.replace(/\.mdx?$/, "") || first.id;

      return (
        <article class="lg:col-span-7 bg-surface rounded-2xl border border-border overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col group">
          <div class="relative aspect-video overflow-hidden">
            <a href={`/posts/${categorySlug}/${slug}`} class="block w-full h-full">
              <img
                src={img}
                alt={first.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </a>
            <span class="absolute top-3 right-3 bg-surface/90 backdrop-blur-sm text-primary text-xs font-bold px-3 py-1 rounded-md shadow-sm border border-border capitalize">
              {first.category}
            </span>
          </div>
          <div class="p-6 md:p-8 flex flex-col flex-grow">
            {dateObj && (
              <div class="text-xs font-bold text-primary tracking-wider uppercase mb-2">
                <FormattedDate date={dateObj} format="long" />
              </div>
            )}
            <h3 class="text-xl md:text-2xl font-bold text-heading group-hover:text-primary transition-colors leading-snug mb-3">
              <a href={`/posts/${categorySlug}/${slug}`}>
                {first.data.title}
              </a>
            </h3>
            {first.data.description && (
              <p class="text-muted text-sm leading-relaxed mb-6 line-clamp-3">
                {first.data.description}
              </p>
            )}
            <div class="mt-auto pt-4 border-t border-border flex items-center justify-between">
              <span class="text-xs font-medium text-muted">{first.data.author || "Admin Madrasah"}</span>
              <a
                href={`/posts/${categorySlug}/${slug}`}
                class="inline-flex items-center gap-1.5 font-bold text-sm text-primary hover:text-secondary transition-colors"
              >
                <span>Baca Selengkapnya</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
        </article>
      );
    })()}

    <!-- 4 Compact Posts on the Right (5 cols) -->
    <div class="lg:col-span-5 flex flex-col justify-between gap-2.5">
      {displayedPosts.slice(1, 5).map((post) => {
        const img = post.data?.heroImage || "/uploads/default-thumb.jpg";
        const pub = post.data?.pubdate ?? null;
        const dateObj = pub ? new Date(pub) : null;
        const rawCategory = post.data?.category || "news";
        const categorySlug = rawCategory.toLowerCase();
        const slug = post.slug || post.id?.split("/").pop()?.replace(/\.mdx?$/, "") || post.id;

        return (
          <article class="bg-surface rounded-xl p-3 border border-border hover:border-primary/40 shadow-sm hover:shadow-md transition-all duration-200 flex gap-3.5 items-center group flex-1">
            <div class="w-20 sm:w-24 h-[66px] rounded-lg overflow-hidden shrink-0">
              <a href={`/posts/${categorySlug}/${slug}`} class="block w-full h-full">
                <img
                  src={img}
                  alt={post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </a>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-0.5">
                <span class="text-[10px] font-bold text-primary uppercase tracking-wider">{post.category}</span>
                {dateObj && (
                  <span class="text-[10px] text-muted">
                    <FormattedDate date={dateObj} format="short" />
                  </span>
                )}
              </div>
              <h4 class="text-xs sm:text-sm font-bold text-heading group-hover:text-primary transition-colors line-clamp-2 leading-snug mb-0.5">
                <a href={`/posts/${categorySlug}/${slug}`}>
                  {post.data.title}
                </a>
              </h4>
              <span class="text-[11px] text-muted capitalize">{post.data.author || "Admin"}</span>
            </div>
          </article>
        );
      })}
    </div>
  </div>
) : layout === 'grid' ? (
  <!-- Layout Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {displayedPosts.map((post) => {
      const img = post.data?.heroImage ?? "/uploads/default-thumb.jpg";
      const pub = post.data?.pubdate ?? null;
      const dateObj = pub ? new Date(pub) : null;
      const rawCategory = post.data?.category || "news";
      const categorySlug = rawCategory.toLowerCase();
      const slug = post.slug || post.id?.split("/").pop()?.replace(/\.mdx?$/, "") || post.id;

      return (
        <div class="bg-surface rounded-xl shadow-sm border border-border overflow-hidden hover:shadow-md transition-shadow flex flex-col h-full group">
          <div class="relative overflow-hidden shrink-0 h-48">
            <a href={`/posts/${categorySlug}/${slug}`} class="block w-full h-full">
              <img
                src={img}
                alt={post.data.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </a>
            {dateObj && (
              <div class="absolute bottom-2 left-2 bg-primary text-white px-2.5 py-0.5 rounded text-xs font-semibold shadow">
                <FormattedDate date={dateObj} format="short" />
              </div>
            )}
            <span class="absolute top-2 right-2 bg-surface/90 backdrop-blur-sm text-primary text-xs font-bold px-2 py-0.5 rounded shadow border border-border capitalize">
              {post.category}
            </span>
          </div>
          <div class="p-5 flex flex-col flex-grow">
            <h3 class="font-bold text-base text-heading group-hover:text-primary transition-colors line-clamp-2 mb-2 leading-snug">
              <a href={`/posts/${categorySlug}/${slug}`}>
                {post.data.title}
              </a>
            </h3>
            {showDescription && post.data.description && (
              <p class="text-muted text-xs line-clamp-2 mb-4 flex-grow">
                {excerpt(post.data.description, 100)}
              </p>
            )}
            <div class="pt-3 border-t border-border mt-auto flex items-center justify-between text-xs text-muted">
              <span>{post.data.author || "Admin"}</span>
              <a href={`/posts/${categorySlug}/${slug}`} class="font-bold text-primary hover:underline">
                Baca &rarr;
              </a>
            </div>
          </div>
        </div>
      );
    })}
  </div>
) : (
  <!-- Layout Sidebar (Horizontal) -->
  <div class="space-y-4">
    {displayedPosts.map((post) => {
      const img = post.data?.heroImage ?? "/uploads/default-thumb.jpg";
      const pub = post.data?.pubdate ?? null;
      const dateObj = pub ? new Date(pub) : null;
      const rawCategory = post.category || post.data.category || "uncategorized";
      const categorySlug = rawCategory.toLowerCase() || "uncategorized";
      const slug = (post.slug || "").toString();

      return (
        <article class="bg-surface border border-border rounded-lg p-3 hover:shadow-md transition-shadow flex gap-3 relative">
          <div class="shrink-0 w-20 h-20 overflow-hidden rounded">
            <a href={`/posts/${categorySlug}/${slug}`}>
              <img
                src={img}
                alt={post.data.title}
                loading="lazy"
                class="w-full h-full object-cover rounded hover:scale-105 transition-transform duration-300"
              />
            </a>
          </div>
          
          <div class="flex-1 min-w-0">
            {dateObj && (
              <div class="text-primary text-xs font-semibold mb-1">
                <FormattedDate date={dateObj} />
              </div>
            )}
            
            <h3 class="font-bold text-sm text-heading hover:text-secondary line-clamp-2 mb-1">
              <a href={`/posts/${categorySlug}/${slug}`}>
                {excerpt(post.data.title, 60)}
              </a>
            </h3>
            
            {showDescription && post.data.description && (
              <p class="text-muted text-xs line-clamp-2">
                {excerpt(post.data.description, 60)}
              </p>
            )}
          </div>
        </article>
      );
    })}
  </div>
)}
