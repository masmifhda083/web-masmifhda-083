---
// src/components/GallerySlider.astro
import { getEntry } from "astro:content";

const about = await getEntry("about", "index").catch(() => null);
const rawItems = about?.data?.gallery?.items || [];

const galleryPhotos = rawItems.length > 0 ? rawItems.map(i => i.image) : [
  "/uploads/cover.webp",
  "/uploads/mifda-1.webp",
  "/uploads/mifda-15.webp",
  "/uploads/bakar.jpeg",
  "/uploads/hero-2.jpg",
  "/uploads/hero-3.jpg",
];

const mainPhoto1 = galleryPhotos[0] || "/uploads/cover.webp";
const mainPhoto2 = galleryPhotos[1] || "/uploads/mifda-1.webp";
const gridPhotos = galleryPhotos.slice(2, 6);
---

<div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-stretch">
  <!-- Photo 1 (Big Left 5 cols) -->
  <div class="md:col-span-5 rounded-2xl overflow-hidden shadow-sm border border-border group relative min-h-[300px]">
    <img
      src={mainPhoto1}
      alt="Kegiatan Siswa"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-5">
      <span class="text-white text-xs font-semibold">Aktivitas Pembelajaran Siswa</span>
    </div>
  </div>

  <!-- Photo 2 (Center Landscape 4 cols) -->
  <div class="md:col-span-4 rounded-2xl overflow-hidden shadow-sm border border-border group relative min-h-[300px]">
    <img
      src={mainPhoto2}
      alt="Dokumentasi Madrasah"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-5">
      <span class="text-white text-xs font-semibold">Upacara & Kebersamaan Madrasah</span>
    </div>
  </div>

  <!-- 4 Grid Photos on Right (3 cols) -->
  <div class="md:col-span-3 grid grid-cols-2 gap-3">
    {gridPhotos.map((img, idx) => (
      <div class="rounded-xl overflow-hidden shadow-sm border border-border group relative aspect-square">
        <img
          src={img}
          alt={`Dokumentasi ${idx + 1}`}
          class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
          loading="lazy"
        />
      </div>
    ))}
  </div>
</div>
