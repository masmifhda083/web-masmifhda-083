---
// src/pages/about/sambutan.astro
import Layout from "../../layouts/Layout.astro";
import { getEntry } from "astro:content";
import Sidebar from "../../components/Sidebar.astro";
import AboutSubNav from "../../components/AboutSubNav.astro";
import MarkdownRenderer from "../../components/MarkdownRenderer.astro";

const about = await getEntry("about", "index");
if (!about) throw new Error("About data not found");

const { sambutan } = about.data;
const item = sambutan.items[0] || {};

const kepsekImage = item?.image || "/uploads/kepsek.webp";
let kepsekName = "Ahmad Rifa'i, M.Pd.";
if (item?.body) {
  const nameMatch = item.body.match(/####\s*\*?\s*([^*#\n]+)\*?\s*$/m);
  if (nameMatch && nameMatch[1]) {
    kepsekName = nameMatch[1].trim();
  }
}
const kepsekRole = "Kepala MA Miftahul Huda Mathla'ul Anwar";

const title = "Sambutan Kepala Madrasah - MA Miftahul Huda";
const description =
  "Amanat kepemimpinan dan sambutan hangat Kepala Madrasah Aliyah Miftahul Huda Mathla'ul Anwar Tambak Jaya, Bapak Ahmad Rifa'i, M.Pd.";

const commitments = [
  {
    title: "Akselerasi Digital & Keterbukaan",
    desc: "Mendorong pemanfaatan teknologi informasi untuk transparansi dan kemudahan akses layanan pendidikan madrasah.",
    icon: "globe",
  },
  {
    title: "Sinergi Komunitas & Wali Santri",
    desc: "Membangun kolaborasi yang erat dan harmonis antara madrasah, orang tua murid, dan masyarakat sekitar.",
    icon: "users",
  },
  {
    title: "Karakter Islami & Prestasi Nyata",
    desc: "Menyiapkan santri yang tangguh secara spiritual, unggul dalam nalar ilmiah, dan siap mengabdi untuk umat.",
    icon: "award",
  },
];
---

<Layout title={title} description={description}>
  <!-- 1. Header Section -->
  <section class="relative bg-gradient-to-b from-primary/10 via-surface to-background pt-10 pb-12 border-b border-border">
    <div class="container mx-auto px-4 max-w-6xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs md:text-sm text-muted mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Home
        </a>
        <span class="text-muted/60">/</span>
        <a href="/about" class="hover:text-primary transition-colors">Tentang Kami</a>
        <span class="text-muted/60">/</span>
        <span class="text-heading font-semibold">Sambutan Kepala Madrasah</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-wider mb-3">
          Amanat Kepemimpinan
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold font-sans text-heading tracking-tight mb-3">
          Sambutan Kepala Madrasah
        </h1>
        <p class="text-sm sm:text-base text-muted leading-relaxed">
          Untaian pesan kepemimpinan, dedikasi pengabdian, dan komitmen berkelanjutan dalam memajukan mutu pendidikan santri MA Miftahul Huda.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Sub-Navigation Tabs -->
  <AboutSubNav active="sambutan" />

  <!-- 3. Main Content Section -->
  <section class="py-12 md:py-16 bg-background">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Column: Sambutan Article (8 Cols) -->
        <div class="lg:col-span-8 space-y-8">
          
          <!-- Box 1: Profil Kepala Madrasah Card -->
          <div class="bg-surface rounded-2xl p-6 sm:p-8 border border-border shadow-sm flex flex-col sm:flex-row items-center sm:items-start gap-6">
            <div class="w-32 sm:w-40 shrink-0 text-center">
              <div class="w-32 h-40 sm:w-40 sm:h-48 rounded-2xl overflow-hidden border-2 border-primary/20 shadow-md bg-background mb-3">
                <img
                  src={kepsekImage}
                  alt={kepsekName}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <span class="inline-block text-[11px] font-bold px-3 py-1 rounded-full bg-primary/10 text-primary uppercase">
                Kepala Madrasah
              </span>
            </div>

            <div class="flex-1 text-center sm:text-left">
              <h2 class="text-xl sm:text-2xl font-bold text-heading mb-1">
                {kepsekName}
              </h2>
              <p class="text-xs sm:text-sm font-semibold text-secondary mb-4">
                {kepsekRole}
              </p>
              <p class="text-xs sm:text-sm text-muted leading-relaxed mb-4">
                Memimpin MA Miftahul Huda Mathla'ul Anwar Tambak Jaya dengan dedikasi penuh mewujudkan madrasah yang unggul secara ilmiah dan berakhlak mulia.
              </p>
              <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 text-xs text-muted">
                <span class="flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  Status Aktif
                </span>
                <span>•</span>
                <span>YPP Miftahul Huda Mathla'ul Anwar</span>
              </div>
            </div>
          </div>

          <!-- Box 2: Teks Lengkap Sambutan -->
          <article class="bg-surface rounded-2xl p-6 sm:p-10 border border-border shadow-sm text-text leading-relaxed text-sm sm:text-base">
            {item?.body ? (
              <div class="prose prose-slate max-w-none prose-headings:text-heading prose-headings:font-bold prose-p:text-text prose-p:leading-relaxed prose-p:my-4 prose-a:text-primary">
                <MarkdownRenderer content={item.body} />
              </div>
            ) : (
              <div class="space-y-6">
                <div class="border-b border-border pb-4">
                  <p class="text-xs font-semibold text-primary uppercase tracking-widest mb-1">
                    Bismillahirrohmanirrahim
                  </p>
                  <h3 class="text-lg sm:text-xl font-bold text-heading">
                    Assalamu‘alaikum Warahmatullahi Wabarakatuh
                  </h3>
                </div>

                <p>
                  Alhamdulillah, puji dan syukur senantiasa kita panjatkan ke hadirat Allah SWT atas limpahan rahmat, taufik, dan inayah-Nya, sehingga kita semua senantiasa diberikan kesehatan serta kesempatan untuk terus berkhidmat di dunia pendidikan Islam.
                </p>

                <p>
                  Kami menyambut dengan hangat dan rasa bangga atas kehadiran seluruh pengunjung di portal resmi <strong>MA Miftahul Huda Mathla'ul Anwar Tambak Jaya, Lampung Barat</strong>.
                </p>
              </div>
            )}

            <!-- Signature Block -->
            <div class="pt-6 border-t border-border flex flex-col items-end mt-8">
              <p class="text-xs text-muted mb-1">Wassalamu‘alaikum Wr. Wb.</p>
              <div class="text-right">
                <span class="block text-xs text-muted font-medium">Kepala MA Miftahul Huda</span>
                <span class="block text-base sm:text-lg font-bold text-heading mt-1">{kepsekName}</span>
                <span class="block text-xs text-primary font-semibold">Tambak Jaya, Lampung Barat</span>
              </div>
            </div>
          </article>

          <!-- Box 3: 3 Fokus Amanat Kepemimpinan -->
          <div class="bg-surface rounded-2xl p-6 sm:p-8 border border-border shadow-sm">
            <h3 class="text-base font-bold text-heading mb-4 pb-3 border-b border-border">
              3 Komitmen Pokok Kepemimpinan Madrasah
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              {
                commitments.map((c, i) => (
                  <div class="p-4 rounded-xl bg-background border border-border/70">
                    <span class="text-xs font-bold text-primary block mb-1">Pilar 0{i + 1}</span>
                    <h4 class="text-sm font-bold text-heading mb-1.5">{c.title}</h4>
                    <p class="text-xs text-muted leading-relaxed">{c.desc}</p>
                  </div>
                ))
              }
            </div>
          </div>

        </div>

        <!-- Right Column: Sidebar (4 Cols) -->
        <Sidebar />

      </div>
    </div>
  </section>
</Layout>
