---
// src/pages/posts/latest/index.astro
export const prerender = true;
import Layout from "../../../layouts/Layout.astro";
import CardPosts from "../../../components/CardPosts.astro";
import Pagination from "../../../components/Pagination.astro";
import { getCollection } from "astro:content";
import { paginate } from "../../../utils/pagination";
import { getVisiblePosts } from "../../../utils/postFilter";

const allPosts = await getCollection("posts");
const visiblePosts = getVisiblePosts(allPosts);

// Urutkan berdasarkan tanggal upload/rilis terbaru (Descending)
const sortedPosts = visiblePosts.sort((a, b) => {
  const dateA = new Date(a.data.pubdate ?? 0).getTime();
  const dateB = new Date(b.data.pubdate ?? 0).getTime();
  return dateB - dateA;
});

const pageSize = 8;
const currentPage = 1;

const pagination = paginate({
  totalItems: sortedPosts.length,
  currentPage,
  pageSize,
});

const pagedPosts = sortedPosts.slice(pagination.start, pagination.end);
const baseUrl = "/posts/latest";

const pageTitle = "Berita & Artikel Terbaru";
const pageDescription = "Daftar semua berita dan artikel terbaru berdasarkan tanggal upload.";
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="bg-gray-50 min-h-screen py-12">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-gray-200">
        <div>
          <h1 class="text-3xl font-bold text-primary">
            {pageTitle}
          </h1>
          <p class="text-sm text-muted mt-1">
            Menampilkan {pagination.start + 1} - {Math.min(pagination.end, sortedPosts.length)} dari {sortedPosts.length} artikel terbaru
          </p>
        </div>
      </div>

      {
        sortedPosts.length === 0 ? (
          <div class="text-center py-16 bg-white rounded-2xl border border-gray-100 shadow-sm">
            <svg
              class="w-16 h-16 mx-auto text-gray-300 mb-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
              />
            </svg>
            <h3 class="text-xl font-bold text-gray-700 mb-2">Belum Ada Artikel</h3>
            <p class="text-gray-500 mb-6">Artikel terbaru akan segera diterbitkan.</p>
            <a
              href="/"
              class="inline-flex items-center gap-2 bg-emerald-700 text-white px-5 py-2.5 rounded-lg hover:bg-emerald-800 transition"
            >
              ← Kembali ke Beranda
            </a>
          </div>
        ) : (
          <div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {pagedPosts.map((post) => {
                const category = (post.data.category || "news").toLowerCase();
                const slug = post.id.split("/").pop()?.replace(/\.mdx?$/, "") || post.id;
                const url = `/posts/${category}/${slug}`;

                return (
                  <CardPosts
                    title={post.data.title}
                    description={post.data.description}
                    image={post.data.heroImage}
                    date={post.data.pubdate ?? null}
                    category={category}
                    url={url}
                    author={
                      post.data.author ? { name: post.data.author } : undefined
                    }
                  />
                );
              })}
            </div>

            {pagination.totalPages > 1 && (
              <div class="mt-12 flex justify-center">
                <Pagination
                  currentPage={pagination.currentPage}
                  totalPages={pagination.totalPages}
                  baseUrl={baseUrl}
                />
              </div>
            )}
          </div>
        )
      }
    </div>
  </section>
</Layout>
